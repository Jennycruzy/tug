{
  "name": "tug",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -b packages/core packages/hl packages/strike apps/engine && tsc -p apps/web",
    "test": "vitest run",
    "engine": "tsx apps/engine/src/main.ts",
    "rules:hash": "tsx packages/core/src/cli/rulesHash.ts",
    "order:rest": "tsx apps/engine/src/cli/order.ts",
    "kill": "tsx apps/engine/src/cli/kill.ts",
    "replay": "tsx apps/engine/src/cli/replay.ts",
    "backfill:sizes": "tsx apps/engine/src/cli/backfill-sizes.ts",
    "site:check": "tsx apps/web/test/site-check.ts",
    "exec:check": "tsx apps/engine/src/cli/exec-check.ts",
    "liquidity": "tsx apps/engine/src/testnetLiquidity.ts",
    "trader": "tsx apps/engine/src/trader-main.ts",
    "web:build": "pnpm --filter @tug/web build"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
