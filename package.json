{
  "name": "tug",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -b packages/core packages/hl packages/strike apps/engine && tsc -p apps/web",
    "test": "vitest run",
    "engine": "tsx apps/engine/src/main.ts",
    "rules:hash": "tsx packages/core/src/cli/rulesHash.ts",
    "order:rest": "tsx apps/engine/src/cli/order.ts",
    "kill": "tsx apps/engine/src/cli/kill.ts",
    "replay": "tsx apps/engine/src/cli/replay.ts",
    "web:build": "pnpm --filter @tug/web build"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
