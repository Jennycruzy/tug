{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile --filter @tug/web...",
  "buildCommand": "pnpm --filter @tug/web build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://tug.38-49-216-59.sslip.io/api/:path*" },
    { "source": "/llms.txt", "destination": "https://tug.38-49-216-59.sslip.io/llms.txt" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
