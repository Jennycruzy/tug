[Unit]
Description=TUG connected accounts (Builder Connect, Strike testnet)
After=network-online.target
Wants=network-online.target

[Service]
User=tug
Group=tug
WorkingDirectory=/home/tug/tug
EnvironmentFile=/home/tug/tug-private/env/connect.env
ExecStart=/home/tug/tug/node_modules/.bin/tsx apps/engine/src/connect-main.ts
Restart=always
RestartSec=5
CPUWeight=200
MemoryMax=1G
StandardOutput=append:/home/tug/tug-private/logs/connect.log
StandardError=append:/home/tug/tug-private/logs/connect.log

[Install]
WantedBy=multi-user.target
