[Unit]
Description=TUG connected accounts (Builder Connect, Strike mainnet; runs only with TUG_CONNECT_MAINNET=on)
After=network-online.target
Wants=network-online.target

[Service]
User=tug
Group=tug
WorkingDirectory=/home/tug/tug
EnvironmentFile=/home/tug/tug-private/env/connect-mainnet.env
ExecStart=/home/tug/tug/node_modules/.bin/tsx apps/engine/src/connect-main.ts
Restart=on-failure
RestartSec=30
CPUWeight=200
MemoryMax=1G
StandardOutput=append:/home/tug/tug-private/logs/connect-mainnet.log
StandardError=append:/home/tug/tug-private/logs/connect-mainnet.log

[Install]
WantedBy=multi-user.target
